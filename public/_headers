# GIS popup fallback when FedCM is unavailable. Other routes retain their policies.
/login
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cache-Control: no-store
/login/
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cache-Control: no-store
/cent-s/login
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cache-Control: no-store
/cent-s/login/
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cache-Control: no-store

# Authenticated identity linking also uses the official GIS popup fallback.
/student/profile
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cache-Control: no-store
/cent-s/student/profile
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cache-Control: no-store
