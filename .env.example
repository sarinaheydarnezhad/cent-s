# Same-origin deployment or Vite's local proxy:
VITE_CENT_API_URL=/api/cent/v1
# For a separate frontend domain, use the existing backend's HTTPS URL followed by /api/cent/v1.
# The API host must allow the frontend origin in Cent__AllowedOrigins__0.
VITE_BASE_PATH=/cent-s/
# Local development only; this value is not included in the browser bundle.
CENT_BACKEND_URL=http://127.0.0.1:5108

# Database credentials, bootstrap secrets and payment credentials belong on the .NET server.
